+class BFloat16Trainer(SimpleTrainer):
+    """
+    Trainer that uses BFloat16 mixed precision.
+    This provides better numeric stability than FP16 (autocast default) 
+    while preserving memory savings and performance on Ampere+ GPUs (A100).
+    """
+    def run_step(self):
+        """
+        Implement the training step logic with BFloat16 support.
+        """
+        assert self.model.training, "[BFloat16Trainer] model was changed to eval mode!"
+        start = time.perf_counter()
+        
+        data = next(self._data_loader_iter)
+        data_time = time.perf_counter() - start
+
+        # Use BFloat16 mixed precision
+        # Note: BFloat16 generally does not require GradScaler for dynamic loss scaling
+        # because it has the same dynamic range as FP32.
+        # We handle compatibility with different PyTorch versions
+        if hasattr(torch, 'amp') and hasattr(torch.amp, 'autocast'):
+            ctx = torch.amp.autocast(device_type="cuda", dtype=torch.bfloat16)
+        else:
+            ctx = torch.cuda.amp.autocast(dtype=torch.bfloat16)
+            
+        with ctx:
+            loss_dict = self.model(data)
+            if isinstance(loss_dict, torch.Tensor):
+                losses = loss_dict
+                loss_dict = {"total_loss": losses}
+            else:
+                losses = sum(loss_dict.values())
+
+        self.optimizer.zero_grad()
+        losses.backward()
+        self.optimizer.step()
+
+        self._write_metrics(loss_dict, data_time)
+
+
+class MultiViewTrainer(DefaultTrainer):
+    """Trainer for multi-view Mask2Former."""
