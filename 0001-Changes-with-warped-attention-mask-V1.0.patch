+def is_thing_class(label: str) -> bool:
+    """Check if a class is a 'thing' (instance) vs 'stuff' (semantic only)."""
+    label_lower = label.lower()
+    return label_lower in THING_CLASSES or label_lower not in STUFF_CLASSES
