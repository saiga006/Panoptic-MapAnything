+def run_panoptic_label_generation(args):
+    """
+    Generate 2D panoptic labels from ScanNet++ 3D mesh annotations.
+    
+    This must be run before training if panoptic annotations don't exist.
+    """
+    from tools.generate_panoptic_labels import (
+        generate_panoptic_labels_parallel,
+        generate_panoptic_for_scene,
+    )
+    
+    scannetpp_root = args.scannetpp_root
+    panoptic_root = args.panoptic_root
+    split_dir = args.split_dir or os.path.join(os.path.dirname(scannetpp_root), "splits")
+    
+    if not scannetpp_root:
+        logger.error("--scannetpp-root is required for label generation")
+        return False
+    
+    if not panoptic_root:
+        panoptic_root = os.path.join(os.path.dirname(scannetpp_root), "panoptic_annotations")
+        logger.info(f"No --panoptic-root specified, using: {panoptic_root}")
+    
+    # Create output directory
+    os.makedirs(panoptic_root, exist_ok=True)
+    
+    # Determine which splits to process
+    splits_to_process = []
+    
+    train_split = os.path.join(split_dir, "nvs_sem_train.txt")
+    val_split = os.path.join(split_dir, "nvs_sem_val.txt")
+    
+    if os.path.exists(train_split):
+        splits_to_process.append(("train", train_split))
+    if os.path.exists(val_split):
+        splits_to_process.append(("val", val_split))
+    
+    if not splits_to_process:
+        logger.error(f"No split files found in {split_dir}")
+        return False
+    
+    # Get number of workers
