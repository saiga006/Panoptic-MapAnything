+            
+            for proj in model.backbone.projections.values():
+                if not isinstance(proj, nn.Identity):
+                    proj.train()
+                    for param in proj.parameters():
+                        param.requires_grad = True
+            print("Backbone re-frozen, deep adapters trainable.")
+
