+
+# Run rsync with progress and partial transfer support
+rsync -avP --partial \
+    "${ITEMS_TO_SYNC[@]}" \
+    ${DEST_HOST}:${DEST_DIR}
+
+RSYNC_EXIT_CODE=$?
+
+echo ""
+echo "========================================="
