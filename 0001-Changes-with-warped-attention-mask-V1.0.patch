+        from mask2former.data.dataset_mappers.scannetpp_panoptic_dataset_mapper import (
+            ScanNetPPMultiViewDatasetMapper
+        )
+        
+        mapper = ScanNetPPMultiViewDatasetMapper(cfg, is_train=False)
