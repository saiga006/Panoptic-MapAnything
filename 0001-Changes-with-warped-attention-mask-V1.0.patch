+from detectron2.modeling.backbone import BACKBONE_REGISTRY
+
+@BACKBONE_REGISTRY.register()
+def build_mapanything_multiview_backbone(cfg, input_shape):
+    return MapAnythingMultiViewBackbone(cfg, input_shape)
