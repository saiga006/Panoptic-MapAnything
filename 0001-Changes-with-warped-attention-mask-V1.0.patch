+        # CRITICAL FIX: Add proper data augmentations!
+        augmentations = [
+            T.ResizeShortestEdge(
+                short_edge_length=(640, 672, 704, 736, 768, 800),
+                max_size=1333,
+                sample_style="choice"
+            ),
+            T.RandomFlip(prob=0.5, horizontal=True, vertical=False),
+        ]
+        
+        print("="*60)
+        print("DATA AUGMENTATIONS ENABLED:")
