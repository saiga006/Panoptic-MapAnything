+                            f"KL div={kl_mean:.4f}, "
+                            f"Class agreement={agree_mean:.4f}"
+                        )
+                        
+                except Exception as e:
+                    logger.warning(f"Failed to analyze scene {scene_id}: {e}")
+                    import traceback
