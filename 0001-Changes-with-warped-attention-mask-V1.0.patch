+from detectron2.modeling.backbone import BACKBONE_REGISTRY
+
+@BACKBONE_REGISTRY.register()
+def build_mapanything_panoptic_dpt_backbone(cfg, input_shape):
+    return MapAnythingWithPanopticDPT(cfg, input_shape)
