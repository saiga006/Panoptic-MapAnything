+"""
+Training script for Mask2Former Panoptic Segmentation Head ONLY (Cluster Version) - FIXED
+Optimized for GPU Cluster (16GB VRAM)
+
+CRITICAL FIXES APPLIED:
+- ✅ Added proper data augmentations (multi-scale resize + random flip)
+- ✅ Increased CLASS_WEIGHT from 2.0 to 5.0 (balance classification vs mask loss)
+- ✅ Fixed LR schedule: Single decay at 70k instead of 60k+80k
+- ✅ Added 1000-iter warmup for stable training start
+- ✅ Improved projection layers (3-layer semantic alignment adapters)
+- ✅ Increased eval/checkpoint frequency (5000 instead of 10000)
+- ✅ ARCHITECTURAL FIX: Corrected DPT channel dimensions (uniform 256, not [256,512,1024,2048])
+- ✅ Added shape verification debugging for feature extraction
+"""
+import warnings
+# Filter specifically by the content of the message
+warnings.filterwarnings("ignore", message=".*torch.cuda.amp.autocast.*", category=FutureWarning)
+import torch
