+"""
+
+import numpy as np
+from pathlib import Path
+
+# Number of semantic classes in ScanNet++
+# You can check this from semantic_classes.txt
+NUM_CLASSES = 3000  # Overestimate to be safe
+
+# Set seed for reproducibility
+np.random.seed(42)
+
