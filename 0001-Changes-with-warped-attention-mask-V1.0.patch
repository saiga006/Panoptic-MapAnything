@@ -0,0 +1,105 @@
+# Base configuration for ScanNet++ Panoptic Segmentation
+# Uses MapAnything backbone (frozen) + Panoptic DPT (trainable) + Mask2Former head
+
+MODEL:
+  BACKBONE:
+    FREEZE_AT: 0  # Not applicable - MapAnything handles freezing internally
+    NAME: "build_mapanything_multiview_backbone"
+  
+  # DINOv2 normalization (used by MapAnything)
+  PIXEL_MEAN: [123.675, 116.280, 103.530]  # ImageNet mean * 255
+  PIXEL_STD: [58.395, 57.120, 57.375]       # ImageNet std * 255
+
+# ========================================
+# DATASET CONFIGURATION
+# ========================================
+# NOTE: These paths must be set by the user
+DATASETS:
+  # Training dataset name (registered via register_scannetpp_panoptic)
+  TRAIN: ("scannetpp_panoptic_train",)
+  # Validation dataset name
+  TEST: ("scannetpp_panoptic_val",)
+
+# ========================================
+# SOLVER (Training) CONFIGURATION
+# ========================================
+SOLVER:
+  IMS_PER_BATCH: 8          # Reduce if GPU memory is limited
+  BASE_LR: 0.0001           # Base learning rate for AdamW
+  DPT_LR: 0.00001           # Learning rate for DPT head (10x lower)
+  
+  # Learning rate schedule (linear warmup + poly decay)
+  STEPS: (60000, 80000)     # When to decay LR
+  MAX_ITER: 90000           # Total training iterations
+  
+  # Warmup configuration
+  WARMUP_FACTOR: 0.001      # Start LR = BASE_LR * WARMUP_FACTOR
+  WARMUP_ITERS: 1000        # Warmup for first 1000 iterations
+  
+  # Regularization
+  WEIGHT_DECAY: 0.05
+  OPTIMIZER: "ADAMW"
+  BACKBONE_MULTIPLIER: 0.1  # Lower LR for backbone (though frozen)
+  
+  # Gradient clipping (important for transformer training)
+  # Per-parameter norm clipping via detectron2's built-in optimizer wrapper.
+  # Value=5.0 is standard for Mask2Former. Previous value of 1.0 combined
+  # with a duplicate GradientClippingHook caused double-clipping that
+  # over-dampened gradients and prevented mask logit recovery.
+  CLIP_GRADIENTS:
+    ENABLED: True
+    CLIP_TYPE: "norm"
+    CLIP_VALUE: 5.0         # Standard Mask2Former value (was 1.0 with double clipping)
+    NORM_TYPE: 2.0
+  
+  # Mixed precision training (saves memory)
+  AMP:
+    ENABLED: True
+
+# ========================================
+# INPUT CONFIGURATION
+# ========================================
+INPUT:
+  # ScanNet++ DSLR images are typically 1568x1168 after undistortion
+  # Resize to 640x480 for memory efficiency (adjust as needed)
+  IMAGE_SIZE: 640
+  MIN_SIZE_TRAIN: (480, 512, 544, 576, 608, 640)
+  MAX_SIZE_TRAIN: 800
+  MIN_SIZE_TEST: 640
+  MAX_SIZE_TEST: 800
+  
+  # Augmentation
+  MIN_SCALE: 0.5
+  MAX_SCALE: 1.5
+  CROP:
+    ENABLED: True
+    TYPE: "absolute"
+    SIZE: [480, 640]
+  
+  # Image format
+  FORMAT: "RGB"
+  
+  # Dataset mapper to use
+  DATASET_MAPPER_NAME: "scannetpp_multiview"
+
+# ========================================
+# EVALUATION CONFIGURATION
+# ========================================
+TEST:
+  EVAL_PERIOD: 5000   # Evaluate every 5000 iterations
+  DETECTIONS_PER_IMAGE: 100
+
+# ========================================
+# DATA LOADER CONFIGURATION
+# ========================================
+DATALOADER:
+  FILTER_EMPTY_ANNOTATIONS: True
+  NUM_WORKERS: 4
+  ASPECT_RATIO_GROUPING: False  # Multi-view batching handles this differently
+
+# ========================================
+# OUTPUT CONFIGURATION
+# ========================================
+OUTPUT_DIR: "./output/scannetpp_multiview"
+
+VERSION: 2
diff --git a/configs/scannetpp/panoptic-segmentation/ma40.yaml b/configs/scannetpp/panoptic-segmentation/ma40.yaml
new file mode 100644
index 0000000..7efea9a
--- /dev/null
+++ b/configs/scannetpp/panoptic-segmentation/ma40.yaml
@@ -0,0 +1,164 @@
+# Multi-View Panoptic Segmentation on ScanNet++ with Query Propagation
+# 
+# This config uses:
+# - MapAnything backbone (frozen) for multi-view feature extraction
+# - Panoptic DPT head (trainable) for FPN-style features
+# - Mask2Former with Query Propagation (trainable) for panoptic prediction
+#
+# Training with 4 views per scene, query propagation from reference to targets
+
+_BASE_: Base-ScanNetPP-PanopticSegmentation.yaml
+
+MODEL:
+  META_ARCHITECTURE: "MultiViewMask2Former"
+  
+  # ========================================
+  # MAPANYTHING CHECKPOINT
+  # ========================================
+  MAPANYTHING:
+    CHECKPOINT_PATH: "pretrained_models/map_anything/test"
+  
+  # ========================================
+  # MULTI-VIEW CONFIGURATION
+  # ========================================
+  MULTIVIEW:
+    NUM_VIEWS: 3              # Number of views per scene
+    USE_POSES: True           # Use camera poses in MapAnything
+    WARMUP_ITER: 500          # Train views independently before query propagation
+    
+    # View selection parameters — OVERLAP-AWARE for query propagation
+    # Views need 50-70% visual overlap so warped attention masks are meaningful.
+    # Previous farthest-point sampling picked maximally-separated views with
+    # almost zero overlap, making query propagation useless.
+    MIN_CAMERA_DISTANCE: 0.3  # Minimum distance between cameras (meters) - avoid duplicates
+    MAX_CAMERA_DISTANCE: 2.0  # Maximum distance — views beyond this have too little overlap
+    MIN_OVERLAP: 0.2          # Minimum overlap between views (estimated)
+    MAX_OVERLAP: 0.8          # Maximum overlap between views
+  
+  # ========================================
+  # SEMANTIC SEGMENTATION HEAD
+  # ========================================
+  SEM_SEG_HEAD:
+    NAME: "MaskFormerHead"
+    IN_FEATURES: ["res2", "res3", "res4", "res5"]
+    IGNORE_VALUE: 255
+    
+    # Number of classes: ScanNet++ semantic_classes.txt has 2878 lines, but
+    # actual panoptic labels only use category_ids 0-253 (215 unique classes).
+    # NUM_CLASSES = max_category_id + 1 = 254 so that:
+    #   - Valid class indices are 0..253, no-object index is 254
+    #   - No collision between category_id=253 and the no-object class
+    #   - 255-way softmax instead of 2879-way → classification cost is meaningful
+    #   - CE gradients ~11x stronger per class
+    #   - class_embed linear: 256x255 instead of 256x2879
+    NUM_CLASSES: 254
+    
+    LOSS_WEIGHT: 1.0
+    CONVS_DIM: 256
+    MASK_DIM: 256
+    NORM: "GN"
+    
+    # Pixel decoder (MSDeformAttn)
+    PIXEL_DECODER_NAME: "MSDeformAttnPixelDecoder"
+    DEFORMABLE_TRANSFORMER_ENCODER_IN_FEATURES: ["res3", "res4", "res5"]
+    COMMON_STRIDE: 4
+    TRANSFORMER_ENC_LAYERS: 6
+  
+  # ========================================
+  # MASK2FORMER TRANSFORMER DECODER
+  # ========================================
+  MASK_FORMER:
+    TRANSFORMER_DECODER_NAME: "MultiScaleMaskedTransformerDecoder"
+    TRANSFORMER_IN_FEATURE: "multi_scale_pixel_decoder"
+    
+    # Deep supervision during training
+    DEEP_SUPERVISION: True
+    
+    # Loss weights: CE=1.0, Mask=2.0, Dice=5.0
+    # Mask (BCE) at 2.0 instead of 5.0: BCE pushes all logits negative on
+    # unmatched queries AND background pixels of matched queries. With equal
+    # BCE and dice weights, the negative pressure from BCE overwhelms dice's
+    # positive pressure because most sampled points are background. Reducing
+    # mask weight to 2.0 while keeping dice at 5.0 gives dice 2.5x more
+    # influence, allowing matched queries to maintain positive predictions.
+    NO_OBJECT_WEIGHT: 0.1     # Weight for "no object" class
+    CLASS_WEIGHT: 1.0         # Cross-entropy weight
+    MASK_WEIGHT: 2.0            # Binary mask loss weight (reduced from 5.0)
+    DICE_WEIGHT: 5.0            # Dice loss weight (strong anti-collapse)
+    
+    # Transformer architecture
+    HIDDEN_DIM: 256
+    NUM_OBJECT_QUERIES: 100   # Max objects per image
+    NHEADS: 8
+    DROPOUT: 0.0
+    DIM_FEEDFORWARD: 2048
+    ENC_LAYERS: 0
+    PRE_NORM: False
+    ENFORCE_INPUT_PROJ: False
+    SIZE_DIVISIBILITY: 32
+    DEC_LAYERS: 10            # 9 decoder layers + 1 for learnable query
+    
+    # Point sampling for loss computation
+    TRAIN_NUM_POINTS: 12544   # 112 * 112 points (CRITICAL: prevents NaN in matcher)
+    OVERSAMPLE_RATIO: 3.0
+    IMPORTANCE_SAMPLE_RATIO: 0.75
+    
+    # Testing thresholds
+    TEST:
+      SEMANTIC_ON: True
+      INSTANCE_ON: True
+      PANOPTIC_ON: True
+      OVERLAP_THRESHOLD: 0.8
+      OBJECT_MASK_THRESHOLD: 0.8
+
+# ========================================
+# INPUT CONFIGURATION (Multi-View)
+# ========================================
+INPUT:
+  # Depth loading for spatial bridging (warped attention masks)
+  LOAD_DEPTH: True
+  DEPTH_CACHE_DIR: null  # Set to a path to cache rendered depths (recommended)
+  
+  # Image size - REDUCED for A40 memory (48GB with 3 views per scene)
+  # Original DSLR images are ~4000x6000, these get resized
+  MIN_SIZE_TRAIN: (384, 416, 448, 480)  # Smaller range for memory
+  MAX_SIZE_TRAIN: 640                    # Reduced from 800
+  MIN_SIZE_TEST: 480
+  MAX_SIZE_TEST: 640
+  FORMAT: "RGB"
+  
+  DATASET_MAPPER_NAME: "scannetpp_multiview"
+
+# ========================================
+# TRAINING SCHEDULE
+# ========================================
+SOLVER:
+  # Memory-optimized: 4 scenes total, 0.5 per GPU (gradient accumulation effective)
+  # Each GPU processes 1 scene with 3 views, but only 4 GPUs active per step
+  # This reduces peak memory vs IMS_PER_BATCH: 8
+  IMS_PER_BATCH: 4            # 4 scenes total (fits in A40 48GB memory)
+  BASE_LR: 0.0001             # Base LR for batch size 4
+  MAX_ITER: 22500             # 90000 / 4 = 22500 iterations
+  
+  # Learning rate schedule
+  STEPS: (15000, 20000)       # Decay at 2/3 and ~90% of training
+  WARMUP_FACTOR: 0.001
+  WARMUP_ITERS: 1000
+  
+  CHECKPOINT_PERIOD: 1500
+
+DATALOADER:
+  NUM_WORKERS: 4              # Reduce to save CPU memory
+
+TEST:
+  EVAL_PERIOD: 0           # Disabled to prevent crash due to missing merged GT JSON
+  DETECTIONS_PER_IMAGE: 100
+
+OUTPUT_DIR: "./output_multiview_4a40"
+
+# ========================================
+# AMP (Mixed Precision)
+# ========================================
+# SOLVER:
+#   AMP:
+#     ENABLED: False
