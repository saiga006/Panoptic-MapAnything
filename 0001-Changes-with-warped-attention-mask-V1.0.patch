+    def __init__(self, cfg):
+        super().__init__(cfg)
+        # Check if we should use BFloat16
+        # If AMP is enabled and hardware supports BF16, switch to BFloat16Trainer
+        # This overrides the AMPTrainer created by DefaultTrainer
+        if cfg.SOLVER.AMP.ENABLED and hasattr(torch.cuda, 'is_bf16_supported') and torch.cuda.is_bf16_supported():
+            logger.info("Hardware supports BFloat16 (A100+). Switching to BFloat16Trainer for improved stability and performance.")
+            self._trainer = BFloat16Trainer(self.model, self.data_loader, self.optimizer)
+
+    def build_hooks(self):
